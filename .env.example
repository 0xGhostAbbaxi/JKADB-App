# PostgreSQL
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/jkadb

# Authentication
JWT_SECRET=generate-a-long-random-secret
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME_NOW

# Real Groq integration (server-side only)
AI_PROVIDER=groq
GROQ_API_KEY=put-your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Optional public contact seed values
PUBLIC_CONTACT_PHONE=
PUBLIC_SUPPORT_EMAIL=
PUBLIC_OFFICE_ADDRESS=
